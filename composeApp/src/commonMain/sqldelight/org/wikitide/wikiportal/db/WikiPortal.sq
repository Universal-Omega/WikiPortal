import kotlin.Boolean;
import kotlin.collections.List;
import org.wikitide.wikiportal.data.model.Rank;
import org.wikitide.wikiportal.data.model.SkinOption;

-- This file describes the latest schema, what a new install gets
-- straight from these CREATE TABLE statements. An existing install
-- gets there through ../migrations/*.sqm instead, see
-- SqlDelightWikiPortalStore.ensureSchema. Changing the schema means
-- adding a new migrations/N.sqm and updating the table below to match,
-- new columns from ALTER TABLE ADD COLUMN go last, since that's where
-- SQLite puts them.

CREATE TABLE IF NOT EXISTS Setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

upsertSetting:
INSERT INTO Setting(key, value) VALUES (?, ?)
ON CONFLICT(key) DO UPDATE SET value = excluded.value;

getSetting:
SELECT value FROM Setting WHERE key = ?;

CREATE TABLE IF NOT EXISTS Wiki (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    baseUrl TEXT NOT NULL,
    scriptPath TEXT NOT NULL,
    skin TEXT NOT NULL,
    articlePathPrefix TEXT,
    faviconUrl TEXT,
    isCustom INTEGER AS Boolean NOT NULL DEFAULT 1,
    availableSkins TEXT AS List<SkinOption>,
    skinIsUserSet INTEGER AS Boolean NOT NULL DEFAULT 0,
    mainPageTitle TEXT,
    folderId TEXT,
    mainPageIsDomainRoot INTEGER AS Boolean NOT NULL DEFAULT 0,
    disableSafeMode INTEGER AS Boolean NOT NULL DEFAULT 0,
    rank TEXT AS Rank NOT NULL DEFAULT ''
);

upsertWiki:
INSERT OR REPLACE INTO Wiki(id, name, description, baseUrl, scriptPath, skin, articlePathPrefix, faviconUrl, isCustom, availableSkins, skinIsUserSet, mainPageTitle, folderId, mainPageIsDomainRoot, disableSafeMode, rank)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteWiki:
DELETE FROM Wiki WHERE id = ?;

-- Presets carry a fixed rank matching their shipped position, and
-- custom wikis get one assigned when added, so the picker's order
-- comes straight from this column instead of being rebuilt in memory
-- after the fact. name is just the tiebreaker for the moment right
-- after an upgrade, before every row has a real rank yet.
selectAllWikis:
SELECT * FROM Wiki ORDER BY rank ASC, name ASC;

CREATE TABLE IF NOT EXISTS Folder (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    rank TEXT AS Rank NOT NULL DEFAULT ''
);

upsertFolder:
INSERT OR REPLACE INTO Folder(id, name, sortOrder, rank)
VALUES (?, ?, ?, ?);

deleteFolder:
DELETE FROM Folder WHERE id = ?;

selectAllFolders:
SELECT * FROM Folder ORDER BY rank ASC, name ASC;

CREATE TABLE IF NOT EXISTS SavedPage (
    wikiId TEXT NOT NULL,
    wikiName TEXT NOT NULL,
    title TEXT NOT NULL,
    extract TEXT NOT NULL,
    thumbnailUrl TEXT,
    savedAtEpochMillis INTEGER NOT NULL,
    url TEXT,
    PRIMARY KEY (wikiId, title)
);

upsertSavedPage:
INSERT OR REPLACE INTO SavedPage(wikiId, wikiName, title, extract, thumbnailUrl, savedAtEpochMillis, url)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSavedPage:
DELETE FROM SavedPage WHERE wikiId = ? AND title = ?;

isSaved:
SELECT EXISTS(SELECT 1 FROM SavedPage WHERE wikiId = ? AND title = ?);

selectAllSavedPages:
SELECT * FROM SavedPage ORDER BY savedAtEpochMillis DESC;

CREATE TABLE IF NOT EXISTS HistoryEntry (
    wikiId TEXT NOT NULL,
    wikiName TEXT NOT NULL,
    title TEXT NOT NULL,
    extract TEXT NOT NULL DEFAULT '',
    thumbnailUrl TEXT,
    visitedAtEpochMillis INTEGER NOT NULL,
    url TEXT,
    PRIMARY KEY (wikiId, title)
);

upsertHistoryEntry:
INSERT OR REPLACE INTO HistoryEntry(wikiId, wikiName, title, extract, thumbnailUrl, visitedAtEpochMillis, url)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectRecentHistory:
SELECT * FROM HistoryEntry ORDER BY visitedAtEpochMillis DESC LIMIT :limit;

deleteHistoryEntry:
DELETE FROM HistoryEntry WHERE wikiId = ? AND title = ?;

clearHistory:
DELETE FROM HistoryEntry;

CREATE TABLE IF NOT EXISTS OfflineArticle (
    wikiId TEXT NOT NULL,
    wikiName TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT,
    htmlFileName TEXT NOT NULL,
    savedAtEpochMillis INTEGER NOT NULL,
    extract TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (wikiId, title)
);

upsertOfflineArticle:
INSERT OR REPLACE INTO OfflineArticle(wikiId, wikiName, title, thumbnailUrl, htmlFileName, savedAtEpochMillis, extract)
VALUES (?, ?, ?, ?, ?, ?, ?);

getOfflineArticleFileName:
SELECT htmlFileName FROM OfflineArticle WHERE wikiId = ? AND title = ?;

deleteOfflineArticle:
DELETE FROM OfflineArticle WHERE wikiId = ? AND title = ?;

selectAllOfflineArticleKeys:
SELECT wikiId, title FROM OfflineArticle;

selectAllOfflineArticles:
SELECT wikiId, wikiName, title, thumbnailUrl, savedAtEpochMillis, extract FROM OfflineArticle ORDER BY savedAtEpochMillis DESC;

-- Only ever populated on the web target. Real platforms (Android,
-- desktop, iOS) store offline article HTML as actual files instead.
CREATE TABLE IF NOT EXISTS OfflineArticleFile (
    fileName TEXT NOT NULL PRIMARY KEY,
    content TEXT NOT NULL
);

upsertOfflineArticleFile:
INSERT OR REPLACE INTO OfflineArticleFile(fileName, content) VALUES (?, ?);

getOfflineArticleFile:
SELECT content FROM OfflineArticleFile WHERE fileName = ?;

deleteOfflineArticleFile:
DELETE FROM OfflineArticleFile WHERE fileName = ?;

CREATE TABLE IF NOT EXISTS OpenTab (
    id TEXT NOT NULL PRIMARY KEY,
    wikiId TEXT NOT NULL,
    wikiName TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT,
    extract TEXT,
    createdAtEpochMillis INTEGER NOT NULL,
    currentUrl TEXT,
    openedFromOffline INTEGER AS Boolean NOT NULL DEFAULT 0
);

upsertOpenTab:
INSERT OR REPLACE INTO OpenTab(id, wikiId, wikiName, title, thumbnailUrl, extract, createdAtEpochMillis, currentUrl, openedFromOffline)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteOpenTab:
DELETE FROM OpenTab WHERE id = ?;

clearOpenTabs:
DELETE FROM OpenTab;

selectAllOpenTabs:
SELECT * FROM OpenTab ORDER BY createdAtEpochMillis ASC;
